{
  "name": "n8n-nodes-argorant",
  "version": "0.3.0",
  "description": "n8n nodes for Argorant, the whole outbound workflow: find leads, check every email, build lists, write and launch campaigns, and handle replies, in workflows or from an AI agent.",
  "license": "MIT",
  "homepage": "https://argorant.com",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "argorant",
    "leads",
    "b2b",
    "lead-generation",
    "email-finder",
    "email-verification",
    "cold-email",
    "outbound",
    "sales",
    "campaigns",
    "ai-agent"
  ],
  "author": {
    "name": "Argorant",
    "email": "support@argorant.com",
    "url": "https://argorant.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/argorant/n8n-nodes-argorant.git"
  },
  "bugs": {
    "url": "https://github.com/argorant/n8n-nodes-argorant/issues"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "test": "npm run build && node --test test/*.test.js"
  },
  "files": [
    "dist",
    "!dist/docs",
    "!dist/templates",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/ArgorantApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Argorant/Argorant.node.js",
      "dist/nodes/ArgorantTrigger/ArgorantTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.55.5",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
