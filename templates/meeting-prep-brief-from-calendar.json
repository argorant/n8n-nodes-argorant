        "simplify": true
      },
      "id": "ae898e39-4610-48bd-b97c-7bd4c0fd4a76",
      "name": "Look up the company",
      "type": "n8n-nodes-argorant.argorant",
      "typeVersion": 1,
      "position": [
        960,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Write a meeting prep brief of at most five short lines for this attendee. Line 1: who they are. Line 2: what their company does. Line 3: company size and location. Lines 4 and 5: two questions worth asking. Use only the facts below; say unknown when a fact is missing.\n\nAttendee: {{ JSON.stringify($('Look up the person').item.json) }}\nCompany: {{ JSON.stringify($json) }}"
      },
      "id": "22486337-8a8c-4727-86e6-ca21790963a7",
      "name": "Write the brief",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
