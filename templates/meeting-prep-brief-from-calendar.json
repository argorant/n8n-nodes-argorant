      "id": "dcd6db94-402e-48ef-a944-ca2f62bd9665",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const s = $('Settings').first().json;\nconst ev = $input.first().json;\nconst people = (ev.attendees || []).map(a => String(a.email || '').toLowerCase()).filter(e => e && !e.endsWith('@' + s.own_domain));\nreturn people.slice(0, s.max_attendees).map(email => ({ json: { email, domain: email.split('@')[1], meeting: ev.summary, start: ev.start?.dateTime || ev.start?.date } }));"
      },
      "id": "fbd09071-2330-4574-ba52-415bb1a79143",
      "name": "External attendees",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "resource": "lead",
        "operation": "enrich",
        "enrichBy": "email",
        "email": "={{ $json.email }}",
        "simplify": true
