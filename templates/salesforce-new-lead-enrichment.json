        "options": {}
      },
      "id": "8eee2143-76f0-4aa0-a7a4-c24ed40f34d0",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c24c3901-c956-4ca4-b80b-63ff9c6e20f9",
              "leftValue": "={{ $('New Salesforce lead').item.json.Email }}",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "77da60c1-7d5f-4531-911d-e1141597fe36",
      "name": "Leads with an email",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "maxItems": "={{ $('Settings').first().json.max_per_poll }}"
      },
      "id": "39cd9e4b-0ca0-49c3-a23c-d9fb12039e48",
      "name": "Cap per poll",
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "resource": "lead",
        "operation": "enrich",
        "enrichBy": "email",
        "email": "={{ $('New Salesforce lead').item.json.Email }}",
        "simplify": true
      },
      "id": "407fa941-cdc9-42a7-8c2e-9d53f2cdf34b",
      "name": "Enrich the person",
      "type": "n8n-nodes-argorant.argorant",
      "typeVersion": 1,
      "position": [
        960,
        0
      ]
    },
    {
      "parameters": {
        "resource": "company",
        "operation": "get",
        "domain": "={{ $('New Salesforce lead').item.json.Email.split('@')[1] }}",
        "previewLimit": 1,
        "simplify": true
      },
      "id": "397a6ff7-5a65-49f4-8545-893a784ddd84",
      "name": "Look up the company",
      "type": "n8n-nodes-argorant.argorant",
      "typeVersion": 1,
      "position": [
        1200,
        0
      ]
    },
    {
      "parameters": {
        "resource": "lead",
        "operation": "update",
        "leadId": "={{ $('New Salesforce lead').item.json.Id }}",
        "updateFields": {
          "title": "={{ $('New Salesforce lead').item.json.Title || $('Enrich the person').item.json.title || '' }}",
          "industry": "={{ $('New Salesforce lead').item.json.Industry || $json.industry || '' }}",
          "numberOfEmployees": "={{ $('New Salesforce lead').item.json.NumberOfEmployees || $json.employee_count || 0 }}",
          "city": "={{ $('New Salesforce lead').item.json.City || $json.city || '' }}",
          "website": "={{ $('New Salesforce lead').item.json.Website || $json.company_domain || '' }}",
          "description": "={{ $('Enrich the person').item.json.linkedin_url ? 'Profile: ' + $('Enrich the person').item.json.linkedin_url : '' }}"
        }
      },
      "id": "de19b20a-55b0-49f7-b7e3-244149e2d7f3",
      "name": "Update the lead",
      "type": "n8n-nodes-base.salesforce",
