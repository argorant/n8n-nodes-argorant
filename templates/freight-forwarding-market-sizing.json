              "name": "countries",
              "value": "Germany, Netherlands, Poland, Spain",
              "type": "string"
            },
            {
              "id": "e5d7ff07-cc93-4f3b-a7dc-f1e2b2bb672b",
              "name": "titles",
              "value": "Head of Supply Chain, Logistics Manager, Head of Procurement, COO",
              "type": "string"
            },
            {
              "id": "5ffb1024-049b-4816-aa0c-f000ce9a3bc5",
              "name": "top_n",
              "value": "2",
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "14b943ea-deb1-45df-aa4a-86c1b03055e1",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const s = $input.first().json;\nreturn s.countries.split(',').map(c => ({ json: { country: c.trim(), titles: s.titles } })).filter(i => i.json.country);"
      },
      "id": "987cd1ca-ca0f-446a-8026-9a30b9964697",
      "name": "One item per country",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "resource": "lead",
        "operation": "count",
        "filterSource": "fields",
        "filters": {
          "title": "={{ $json.titles }}",
          "country": "={{ [$json.country] }}",
          "industries": [
            "Wholesale",
            "Manufacturing",
            "E-commerce"
          ]
        }
      },
      "id": "0b1556e1-20d4-43c8-96b3-8c65e3cb6850",
      "name": "Count buyers per country",
      "type": "n8n-nodes-argorant.argorant",
      "typeVersion": 1,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const top = $('Settings').first().json.top_n;\nconst rows = $input.all().map((i, k) => ({ country: $('One item per country').all()[k].json.country, titles: $('One item per country').all()[k].json.titles, buyers: Number(i.json.count || 0) }));\nrows.sort((a, b) => b.buyers - a.buyers);\nreturn rows.map((r, k) => ({ json: { ...r, rank: k + 1, top: k < top } }));"
      },
      "id": "5f5db3e2-c600-4efa-a2b6-f4b5df46f858",
      "name": "Rank the countries",
