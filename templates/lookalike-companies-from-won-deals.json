    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json).filter(c => c.found);\nif (!rows.length) return [];\nconst top = key => { const n = {}; for (const r of rows) if (r[key]) n[r[key]] = (n[r[key]] || 0) + 1;\n  return Object.entries(n).sort((a, b) => b[1] - a[1])[0]?.[0] || ''; };\nconst size = top('employee_range').replace(/,/g, '');\nreturn [{ json: { industry: top('industry'), employee_range: size, known: $('Won customers').all().map(i => String(i.json.company_domain || '').toLowerCase()) } }];"
      },
      "id": "b1215546-81cb-4745-90e8-98b0b40d7416",
      "name": "Most common profile",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
