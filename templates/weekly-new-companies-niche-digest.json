        "width": 460,
        "color": 7
      },
      "id": "c192f9be-8904-455e-9b42-40c1ce5bcd28",
      "name": "Sticky Note 1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        900,
        -140
      ]
    },
    {
      "parameters": {
