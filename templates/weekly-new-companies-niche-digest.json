      ]
    },
    {
      "parameters": {
        "resource": "company",
        "operation": "search",
        "filters": {
          "keywords": "={{ $json.keywords }}",
          "country": "={{ [$json.country] }}",
          "foundedMin": "={{ $json.founded_since }}"
        },
        "returnAll": false,
        "limit": "={{ $json.max_results }}",
        "simplify": true
      },
