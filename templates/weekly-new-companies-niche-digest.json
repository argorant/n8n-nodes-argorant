      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "operation": "removeItemsSeenInPreviousExecutions",
        "dedupeValue": "={{ $json.company_domain }}",
        "options": {}
      },
      "id": "e33a140f-2928-4872-9926-6932c26e8114",
      "name": "Not shown before",
      "type": "n8n-nodes-base.removeDuplicates",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nif (!rows.length) return [];\nconst lines = rows.map(c => `• ${c.company_name || c.display_name} (${c.company_domain}), ${c.employee_range || 'size unknown'}, ${c.city || c.country || ''}`);\nreturn [{ json: { text: `${rows.length} new companies in your niche this week:\\n` + lines.join('\\n') } }];"
      },
      "id": "b75d6cb4-0556-478d-9991-c036e81c00fa",
      "name": "Build the digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ]
    },
    {
