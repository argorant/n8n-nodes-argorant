              "body": "Hi {{first_name|there}},\n\nWe help stores like {{company|yours}} get more out of the tools you already run.\n\nWorth a 15 minute call next week?\n\nAlex",
              "delayDays": 0
            },
            {
              "subject": "",
              "body": "Hi {{first_name|there}}, should I send a two-line summary instead?",
              "delayDays": 4
            }
          ]
        },
        "senderMode": "none",
        "settings": {
          "tags": "ecommerce"
        },
        "simplify": true
      },
