              "subject": "Properties in {{city|your area}}",
              "body": "Hi {{first_name|there}},\n\nWe work with property teams in {{city|your area}} on the jobs that eat your week.\n\nOpen to a short call next week?\n\nAlex",
              "delayDays": 0
            },
            {
              "subject": "",
              "body": "Hi {{first_name|there}}, happy to send a one-page overview instead.",
              "delayDays": 4
            }
          ]
        },
        "senderMode": "none",
        "settings": {
          "tags": "real-estate"
        },
        "simplify": true
      },
