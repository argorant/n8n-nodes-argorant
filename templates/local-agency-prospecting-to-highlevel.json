      "typeVersion": 3.4,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "resource": "lead",
        "operation": "reveal",
        "revealBy": "filters",
        "filterSource": "fields",
        "filters": {
          "keywords": "={{ $('Settings').first().json.keywords }}",
          "seniority": [
            "Owner",
            "Founder",
            "Partner"
          ],
          "nearPlace": "={{ $('Settings').first().json.place }}",
          "radius": "={{ $('Settings').first().json.radius_miles }}",
          "radiusUnit": "mi"
        },
        "revealCount": "={{ $('Settings').first().json.max_people }}",
        "simplify": true
      },
      "id": "346f891d-6efc-412f-a571-dd5ba9693f93",
      "name": "Reveal local owners",
