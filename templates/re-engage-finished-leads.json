    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "662c83da-d4a9-4271-82d7-421a9570a41f",
              "leftValue": "={{ $json.last_sent_at }}",
              "operator": {
                "type": "dateTime",
                "operation": "before"
              },
              "rightValue": "={{ $now.minus({ days: $('Settings').first().json.min_days_quiet }).toISO() }}"
