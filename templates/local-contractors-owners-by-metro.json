    {
      "parameters": {
        "jsCode": "const metros = $('One item per metro').all().map(i => i.json.metro);\nconst max = $('Settings').first().json.max_per_metro;\nconst lines = $input.all().map((i, k) => `${metros[k]}: ${i.json.count} owners${i.json.count > 0 && i.json.count <= max ? ' (added)' : ' (not added: over budget or none)'}`);\nreturn [{ json: { text: `Contractors this week (budget ${max} per metro):\\n` + lines.join('\\n') } }];"
      },
