                "operation": "equals"
              },
              "rightValue": "campaign.paused"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b090edd0-d3fc-4419-8e5b-9a5e4ffd14f3",
      "name": "Paused?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "resource": "mailbox",
        "operation": "getMany",
        "mailboxFilters": {
          "status": [
            "needs_attention",
            "not_connected",
            "paused"
          ]
        },
        "returnAll": false,
        "limit": 50,
        "simplify": true
      },
      "id": "12ce2ac5-3fe4-4fc3-a5de-78f15d3d3419",
      "name": "Mailboxes to fix",
      "type": "n8n-nodes-argorant.argorant",
      "typeVersion": 1,
      "position": [
        480,
        -100
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const evt = $('Campaign paused or resumed').first().json;\nconst boxes = $input.all().map(i => i.json).filter(m => m.email);\nconst list = boxes.length ? boxes.map(m => `- ${m.email}: ${m.status_label || m.status}`).join('\\n') : 'No mailbox is flagged right now.';\nreturn [{ json: { text: `:warning: *${evt.campaign_name || 'A campaign'} paused*\\n${evt.message || evt.reason || ''}\\n\\n*Mailboxes to check*\\n${list}\\n\\n${evt.url || 'https://app.argorant.com/campaigns'}` } }];"
      },
      "id": "89c596ad-b7d6-44ab-a07d-7e402c4d139f",
      "name": "Build the alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        -100
      ]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
