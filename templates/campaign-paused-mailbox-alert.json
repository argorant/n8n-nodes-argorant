        ],
        "options": {}
      },
      "id": "b7480554-0b79-4e16-960c-4b6b2e3293c6",
      "name": "Campaign paused or resumed",
      "type": "n8n-nodes-argorant.argorantTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "webhookId": "dbfe4135-6cd1-47d9-bb8e-a904ad5ea707"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "4513276c-20ba-49ca-809c-2b3d75e963b6",
              "leftValue": "={{ $json.event }}",
              "operator": {
