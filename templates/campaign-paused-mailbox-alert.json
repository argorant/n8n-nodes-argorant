        },
        "text": "=:white_check_mark: {{ $json.campaign_name || 'A campaign' }} sends again. {{ $json.message || '' }}",
        "otherOptions": {}
      },
      "id": "18557d19-037c-40ed-91d3-96e86ed347a0",
