          "mode": "list",
          "value": ""
        },
        "text": "={{ $json.text }}",
        "otherOptions": {}
      },
      "id": "8246ba6c-804b-4a24-bc24-06ba8e910c3e",
      "name": "Post the alert",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
