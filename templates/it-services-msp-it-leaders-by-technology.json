        "name": "=IT leaders on {{ $('Market form').item.json.Technology }}, {{ $('Market form').item.json.Country }}",
        "steps": {
          "step": [
            {
              "subject": "Who keeps your platforms running, {{first_name|there}}?",
              "body": "Hi {{first_name|there}},\n\nWe look after the platforms teams like {{company|yours}} run every day: updates, security and the tickets nobody has time for.\n\nWould a 20 minute call next week be useful to compare notes?\n\nAlex",
              "delayDays": 0
            },
            {
              "subject": "",
              "body": "Hi {{first_name|there}}, worth a short call, or should I check back next quarter?",
              "delayDays": 4
            }
          ]
        },
        "senderMode": "none",
        "settings": {
          "tags": "msp"
        },
        "simplify": true
      },
      "id": "7246a597-a3cc-4b35-bf84-bc6cd3f11caf",
      "name": "Create the campaign draft",
