              "id": "4e9db9e4-3474-4b8c-88a4-f6d851af7d06",
              "leftValue": "={{ $('Count IT leaders').item.json.count }}",
              "operator": {
                "type": "number",
                "operation": "lte"
              },
              "rightValue": "={{ $('Settings').item.json.max_people }}"
            },
            {
              "id": "b1215546-81cb-4745-90e8-98b0b40d7416",
              "leftValue": "={{ $('Count IT leaders').item.json.count }}",
              "operator": {
