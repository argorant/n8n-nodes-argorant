    {
      "parameters": {
        "promptType": "define",
        "text": "=Write a short reply (under 80 words, plain text, no subject line) to this interested prospect. Thank them in one sentence, answer their question if they asked one, and propose a 20 minute call with this link: {{ $('Settings').item.json.calendar_link }}. Sign as {{ $('Settings').item.json.sender_name }}. Do not invent facts.\n\nTheir reply:\n{{ $json.body }}"
      },
