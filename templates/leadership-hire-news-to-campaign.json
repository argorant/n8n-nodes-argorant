          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "40214ef2-6d71-4400-8fa5-22d8670977b0",
              "leftValue": "={{ $json.status }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "valid"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "1b8d5624-d128-4a4f-b9f1-0245dcdffc32",
      "name": "Confirmed email?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1680,
        0
      ]
    },
    {
      "parameters": {
        "resource": "campaign",
        "operation": "addLeads",
        "campaignId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "leadSource": "items",
        "leadEmail": "={{ $json.email }}",
        "leadFields": {
          "first_name": "={{ $('Extract the new leader').item.json.output.first_name }}",
