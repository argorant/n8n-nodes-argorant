      "name": "Bounce or opt-out",
      "type": "n8n-nodes-argorant.argorantTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "webhookId": "a0784968-504e-4000-bef3-9d7e2086b68c"
    },
    {
      "parameters": {
