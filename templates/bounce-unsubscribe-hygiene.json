              "type": "string"
            },
            {
              "id": "6b8ae156-8412-4e1c-bb18-b6395cfbf1b8",
              "name": "reason",
              "value": "={{ $json.event === 'email.bounced' ? 'bounced' : 'unsubscribed' }}",
              "type": "string"
            },
            {
              "id": "0990f368-96d8-42b0-b346-b7fde7a81445",
              "name": "campaign_id",
              "value": "={{ $json.campaign_id }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "ca42542e-1f36-443f-8dc6-8570724613e4",
