      "id": "ed4703e0-7758-4e47-ad66-4ba5cd2cf6b9",
      "name": "New reply",
      "type": "n8n-nodes-argorant.argorantTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "webhookId": "c4181942-fa0a-4cef-affc-394896b6c4d9"
    },
    {
      "parameters": {
        "resource": "reply",
        "operation": "get",
        "conversationId": "={{ $json.conversation_id }}",
        "simplify": true
      },
      "id": "6fbce2ad-5a3f-46a4-9259-f1fe2735db59",
      "name": "Read the thread",
      "type": "n8n-nodes-argorant.argorant",
      "typeVersion": 1,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Conversation ID: {{ $('New reply').item.json.conversation_id }}\nCampaign ID: {{ $('New reply').item.json.campaign_id }}\nFrom: {{ $('New reply').item.json.lead_email }}\nSubject: {{ $json.subject }}\n\nReply:\n{{ $json.body || $('New reply').item.json.snippet }}",
        "options": {
          "systemMessage": "You triage replies to B2B outreach for the user's team. For each reply:\n1. Call Get reply statuses once and use only those keys.\n2. Call Set reply status with the best key: positive for interest, meeting_request for a meeting, unsubscribe when the person asks to stop, neutral when unclear.\n3. If the person asks to stop or not to be contacted, call Block address with their email.\n4. If the person says they are the wrong contact or left the company, call Remove from campaign with their email and the campaign id.\n5. Never write to the prospect. Answer with two short lines: the status you set and what the reply says.",
          "maxIterations": 10
        }
      },
      "id": "ee678d69-0c49-47a5-bde8-af4153d4dda2",
      "name": "Reply triage agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
