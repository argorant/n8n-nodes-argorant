      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const s = $('Settings').first().json;\nconst p = $('Enrich the person').first().json;\nconst c = $input.first().json;\nconst seniorities = s.seniorities.split(',').map(x => x.trim().toLowerCase());\nconst countries = s.countries.split(',').map(x => x.trim().toLowerCase());\nlet score = 0; const reasons = [];\nif (p.found && seniorities.includes(String(p.seniority || '').toLowerCase())) { score += 40; reasons.push('seniority'); }\nif (Number(c.employee_count || 0) >= Number(s.min_employees)) { score += 35; reasons.push('company size'); }\nif (countries.includes(String(c.country || p.country || '').toLowerCase())) { score += 25; reasons.push('country'); }\nreturn [{ json: { email: $('New signup').first().json.body.email, first_name: p.first_name || '', last_name: p.last_name || '',\n  company: p.company || c.company_name || '', title: p.title || '', score, reasons, fit: score >= 60 } }];"
      },
      "id": "f11b35c1-cb70-428b-a548-fc4a06e2cc98",
