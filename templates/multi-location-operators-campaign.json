            {
              "subject": "One setup for every site, {{first_name|there}}",
              "body": "Hi {{first_name|there}},\n\nTeams that run many locations like {{company|yours}} usually juggle a different vendor per site. We cover all of them with one contract.\n\nWorth a short call?\n\nAlex",
              "delayDays": 0
            },
            {
              "subject": "",
              "body": "Hi {{first_name|there}}, happy to send numbers from a similar operator instead.",
              "delayDays": 4
            }
          ]
        },
        "senderMode": "none",
        "settings": {
          "tags": "multi-site"
        },
        "simplify": true
      },
