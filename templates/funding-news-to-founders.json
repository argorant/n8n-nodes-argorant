      "id": "e4ac2f94-6f94-4824-884b-206cddc092af",
      "name": "Find founders and finance leaders",
      "type": "n8n-nodes-argorant.argorant",
      "typeVersion": 1,
      "position": [
        1440,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const people = $input.all().map(i => i.json).filter(p => p.record_id);\nconst companies = [...new Set(people.map(p => p.company).filter(Boolean))];\nreturn people.length ? [{ json: { record_ids: people.map(p => p.record_id).join(','), people: people.length, companies: companies.join(', ') } }] : [];"
      },
      "id": "7e9d8eb0-066a-478e-b80c-b7e2af7b3afb",
      "name": "Collect",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        0
      ]
    },
    {
      "parameters": {
        "resource": "list",
        "operation": "create",
        "name": "=Funding news {{ $now.toISODate() }}",
        "peopleSource": "recordIds",
        "recordIds": "={{ $json.record_ids }}",
        "simplify": true
